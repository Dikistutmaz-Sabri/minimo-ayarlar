# The desktop's right click (pleamar-wm's: screenshot, screencast, terminal,
# wallpaper, settings), the same scene as in pleamar-wm's session, in
# Minimo's session only.
[Unit]
Description=Minimo OS desktop right-click menu (pleamar)
PartOf=minimo-session.target
After=minimo-session.target minimo-shell.service

[Service]
ExecStartPre=/bin/sleep 2
ExecStart=%h/.local/bin/pleamar --scene %h/.config/pleamar/shells/desktop/desktop.plm --no-hud
Restart=on-failure
RestartSec=3

[Install]
WantedBy=minimo-session.target
