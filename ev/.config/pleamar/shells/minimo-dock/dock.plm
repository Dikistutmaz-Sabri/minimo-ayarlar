language 0.1

// Minimo OS's dock, pleamar-wm's shore copied: a dark strip joined to the
// bottom edge by a neck, rising out of it (and sinking back when a window
// comes over it, a window is fullscreen, or windows are tiled —the mouse at
// the bottom edge brings it back—). On it the programs kept there and the
// others with windows, a drop under each per window (mint, the one with the
// keyboard; a coral one when a window asks for you); hovering, the icons rise
// like buoys on a passing wave; pressed, one dips and rings the water, and
// goes to its window —the next one, pressed again—, comes back if put away,
// or starts. Its name over it; held, its windows to pick from; a file dropped
// on it opens with it; the right button keeps it or lets it go, opens another
// window, closes its windows; carried up off the shore, it is let go. Then
// the windows put away (Super+M, or the amber drop on a title bar), each a
// small picture of itself with its program's icon; then the pools (the
// workspaces), and tiled or free windows. dock.luau reads Hyprland;
// minimo-dock.service starts it, in Minimo's session only.

scene MinimoDock {
    surface {
        size: 1400, 520
        anchor: bottom
        margin: 0, 0, 0, 0
        level: top
        reserve: 0
        keyboard: exclusive while appsopen
    }
    permissions {
        run: "hyprctl", "sh"
        services: "apps", "apps.launch", "env"
    }

    let ink = #f5f7f5
    let mint = #9ed6bd
    let coral = #ef7a66
    let glass_tint = #2b3139      // MacShell ailesi soğuk dumanlı sıvı cam

    //  Launchpad: impasto'daki gibi bir apps ikonu, soldaki düğme; basınca
    //  bütün uygulamaların ızgarası (apps servisinden, dock.luau doldurur).
    image apps_ico = file "cachyos.svg", 64, 64
    text draft = ""             // arama kutusunun metni
    model pad max 200 { icon: image 96, 96; name: text; letter: text; head: bool = false }
    model azs max 30 { ch: text; row: number = 0; active: bool = false }
    fact g = 0                  // launcher'da gösterilen uygulama sayısı
    fact sel = 0                // seçili satır (klavye)
    fact appsopen = false
    event launch_app ->
    event apps_toggle ->
    event slid ->

    model items max 16 { icon: image 96, 96; name: text; wins: number = 0; active: bool = false; urgent: bool = false; pinned: bool = false }
    model away max 8 { thumb: image 160, 100; icon: image 40, 40; title: text; has_thumb: bool = false }
    model pools max 10 { active: bool = false; wins: number = 0 }
    model peeks max 8 { title: text; hidden: bool = false }
    fact n = 0                  // programs
    fact a = 0                  // windows put away
    fact p = 0                  // pools
    fact free = true            // free windows (Super+W): tiled, the shore sinks
    fact hide = false           // a window over it, or one fullscreen (dock.luau)
    fact reveal = false         // the mouse at the bottom edge: it comes back
    fact hov = -1               // the program under the pointer
    fact carry = -1             // the one being carried off the shore
    fact peek = -1              // the one whose windows are listed (held)
    fact menu = -1              // the one whose menu is open (right button)
    fact menu.wins = 0
    text menu.pin = ""
    event pick ->
    event peek_at ->
    event go ->
    event menu_at ->
    event menu_do ->
    event unpin ->
    event dropped ->
    event back ->
    event pool ->
    event mode ->
    //  A window put away: from where it shrank to (drop.x, in this surface's
    //  coordinates), a drop falls into the dock and rings the water there
    //  (dock.luau counts drop.n up; landing keeps the dock up meanwhile).
    fact drop.x = 700
    fact drop.n = 0
    fact landing = false
    event dusus ->

    // ── where things go ──
    spring rise = 190, 20
    prop sh = 0 ~rise
    follow sh = if((hide or not free) and not reveal and not landing and peek < 0 and menu < 0 and carry < 0 and not appsopen, 0, 1)
    let on = sh > 0.6
    let tw = 28 + 60 + n * 60 + if(a > 0, 20 + a * 76, 0) + 20 + p * 26 + 52
    prop dkw = 200 ~lively
    follow dkw = tw
    let x0 = 700 - dkw / 2
    let cy = 520 + 42 - 88 * sh
    let xi = x0 + 14 + 60            // apps düğmesinden sonra programlar başlar
    let xa = xi + n * 60 + 20
    let xp = x0 + dkw - 14 - 52 - p * 26
    let xm = x0 + dkw - 14 - 26
    //  The wave of buoys: where the mouse is, in programs.
    let t = (pointer.x - xi) / 60 - 0.5

    //  Sunk, the bottom edge waits for the mouse.
    zone box edge { from: 0, 512; size: 1400, 8; active: sh < 0.4 }
    on enter edge { reveal = true }

    //  Anywhere else, while a list or a menu is up: it closes them.
    zone box outside { from: 0, 0; size: 1400, 520; active: peek >= 0 or menu >= 0 or appsopen }
    on press outside { peek = -1; menu = -1; appsopen = false }
    on press right outside { peek = -1; menu = -1; appsopen = false }

    // ── the shore, joined to the edge by a neck ──
    group {
        show: sh > 0.01
        body {
            color: glass_tint
            glass: 90%
            lens: false
            rim: 45%
            shine: pointer
            highlight: 70%
            shadow: 0, 18, 46, 40%
            box { from: -80, 520; size: 1560, 140 }
            box { at: x0 + dkw / 2, cy; size: dkw * (0.55 + 0.45 * sh), 64; corner: 26; blend: 22 + 36 * 4 * sh * (1 - sh) }
        }
    }
    zone box shore_z { at: x0 + dkw / 2, cy; size: dkw, 64; corner: 22; active: on }
    fact inshore = false
    on enter shore_z { inshore = true }
    on leave shore_z { inshore = false }
    let near = hov >= 0 or inshore

    // ── the programs ──
    component Item(d: record) {
        size: 60, 64
        prop glow = 0 ~140ms
        prop buoy = 0 ~lively
        follow buoy = if(near and carry < 0, pow(max(0, 1 - abs(d.index - t) / 2.2), 2), 0)
        prop ring = 1 ~760ms
        let carried = if(carry == d.index, 1, 0)
        let s = 42 * (1 + 0.62 * buoy)
        group {
            move: carried * drag.dx, carried * drag.dy
            opacity: 1 - carried * 0.35
            //  Pressed: it rings the water under it.
            ellipse { at: 30, 54; radius: 18 + 30 * ring; scale: 1, 0.32; stroke: 1.4 * (1 - ring) + 0.3; color: ink; opacity: 45% * (1 - ring); show: ring < 0.99 }
            image d.icon { at: 30 - s / 2, 29 - 20 * buoy - s / 2; size: s, s }
            //  Something unread, a window asking: a coral drop.
            ellipse { at: 30 + s * 0.38, 29 - 20 * buoy - s * 0.38; radius: 4.5; color: coral; show: d.urgent }
            //  A drop per window (one, two, three or more), mint for the one with the keyboard.
            ellipse { at: 30, 57; radius: if(d.active, 2.4, 2); color: if(d.active, mint, ink); opacity: if(d.active, 95%, 55%); show: d.wins == 1 or d.wins >= 3 }
            ellipse { at: 26.5, 57; radius: if(d.active, 2.4, 2); color: if(d.active, mint, ink); opacity: if(d.active, 95%, 55%); show: d.wins == 2 }
            ellipse { at: 33.5, 57; radius: if(d.active, 2.4, 2); color: if(d.active, mint, ink); opacity: if(d.active, 95%, 55%); show: d.wins == 2 }
            ellipse { at: 24, 57; radius: 2; color: if(d.active, mint, ink); opacity: if(d.active, 95%, 55%); show: d.wins >= 3 }
            ellipse { at: 36, 57; radius: 2; color: if(d.active, mint, ink); opacity: if(d.active, 95%, 55%); show: d.wins >= 3 }
        }
        //  Its name over it.
        group {
            opacity: glow * if(peek < 0 and menu < 0 and carry < 0, 1, 0)
            body {
                color: #15181b
                rim: 12%
                shadow: 0, 4, 12, 40%
                box { at: 30, -26; size: 170, 28; corner: 10 }
            }
            text d.name { at: 30, -26; anchor: center; size: 12; weight: 500; width: 160; lines: 1; align: center; color: ink }
        }
        zone box touch { at: 30, 32; size: 60, 64; cursor: pointer; label: d.name; role: button; active: on }
        on enter touch { glow: 1; hov = d.index }
        on leave touch { glow: 0; hov = -1 }
        on press touch { impulse buoy -9 }
        on release touch while carry < 0 and peek < 0 and menu < 0 {
            ring: 0 ~0ms
            ring: 1 ~760ms after 16ms
            emit pick(d.index)
        }
        on release touch while carry == d.index and drag.dy < -110 { emit unpin(d.index) }
        on release touch { carry = -1 }
        on drag touch while carry < 0 and drag.dy < -24 { carry = d.index }
        on hold touch for 550ms { peek = d.index; emit peek_at(d.index) }
        on press right touch { menu = d.index; peek = -1; emit menu_at(d.index) }
        on drop touch { emit dropped(d.index) }
    }
    row { at: xi, cy - 32; gap: 0
        for d in items { Item(d) } }

    // ── apps / Launchpad düğmesi (impasto'daki apps ikonu, soldaki uç) ──
    group {
        show: sh > 0.01
        prop aglow = 0 ~140ms
        prop adip = 0 ~lively
        let as = 38 * (1 + 0.14 * aglow)
        image apps_ico { at: x0 + 44 - as / 2, cy - 2 - 3 * adip - as / 2; size: as, as }
        ellipse { at: x0 + 44, cy + 25; radius: 2.4; color: mint; opacity: if(appsopen, 95%, 0%) }
        group {
            opacity: aglow * if(peek < 0 and menu < 0 and carry < 0 and not appsopen, 1, 0)
            body { color: #15181b; rim: 12%; shadow: 0, 4, 12, 40%
                   box { at: x0 + 44, cy - 58; size: 150, 28; corner: 10 } }
            text "Uygulamalar" { at: x0 + 44, cy - 58; anchor: center; size: 12; weight: 500; color: ink }
        }
        zone box apps_z { at: x0 + 44, cy; size: 54, 60; corner: 14; cursor: pointer; label: "Uygulamalar"; role: button; active: on }
        on enter apps_z { aglow: 1 }
        on leave apps_z { aglow: 0 }
        on press apps_z { impulse adip 1; toggle appsopen; emit apps_toggle }
    }

    // ── a line of water, then the windows put away ──
    box { at: xa - 10, cy; size: 1, 30; color: ink; opacity: 18%; show: a > 0 and sh > 0.01 }
    component Away(v: record) {
        size: 76, 64
        prop glow = 0 ~140ms
        prop ring = 1 ~760ms
        group {
            move: 0, -4 * glow
            ellipse { at: 38, 54; radius: 22 + 30 * ring; scale: 1, 0.32; stroke: 1.4 * (1 - ring) + 0.3; color: ink; opacity: 45% * (1 - ring); show: ring < 0.99 }
            //  A small picture of it, as it was when it went.
            group {
                show: v.has_thumb
                clip box { at: 38, 30; size: 64, 40; corner: 6 }
                image v.thumb { at: 6, 10; size: 64, 40 }
            }
            box { at: 38, 30; size: 64, 40; corner: 6; color: #0c0e10; show: not v.has_thumb }
            image v.icon { at: 26, 18; size: 24, 24; show: not v.has_thumb }
            box { at: 38, 30; size: 64, 40; corner: 6; stroke: 1.2; color: ink; opacity: 18% + 30% * glow }
            //  Its program's icon on its corner.
            image v.icon { at: 54, 36; size: 20, 20; show: v.has_thumb }
        }
        group {
            opacity: glow * if(peek < 0 and menu < 0, 1, 0)
            body {
                color: #15181b
                rim: 12%
                shadow: 0, 4, 12, 40%
                box { at: 38, -26; size: 220, 28; corner: 10 }
            }
            text v.title { at: 38, -26; anchor: center; size: 12; weight: 500; width: 210; lines: 1; align: center; color: ink }
        }
        zone box hit { at: 38, 32; size: 76, 64; cursor: pointer; label: v.title; role: button; active: on }
        on enter hit { glow: 1 }
        on leave hit { glow: 0 }
        on release hit {
            ring: 0 ~0ms
            ring: 1 ~760ms after 16ms
            emit back(v.index)
        }
    }
    row { at: xa, cy - 32; gap: 0
        for v in away { Away(v) } }

    // ── before the pools, a line of water; then the pools ──
    box { at: xp - 10, cy; size: 1, 30; color: ink; opacity: 18%; show: sh > 0.01 }
    component Pool(q: record) {
        size: 26, 64
        prop glow = 0 ~140ms
        ellipse { at: 13, 32; radius: 8 + 1.5 * glow; stroke: 1.3; color: ink
                  opacity: if(q.index == p - 1 and q.wins == 0, 22%, 45%) + 25% * glow; show: not q.active }
        ellipse { at: 13, 32; radius: 8 + 1.5 * glow; color: mint; opacity: 90%; show: q.active }
        text number(q.index + 1, 0) { at: 13, 32; anchor: center; size: 9; weight: 700; color: #0c0e10; show: q.active }
        zone ellipse hit { at: 13, 32; radius: 12; cursor: pointer; label: "Masaüstü"; role: button; active: on }
        on enter hit { glow: 1 }
        on leave hit { glow: 0 }
        on press hit { emit pool(q.index) }
    }
    row { at: xp, cy - 32; gap: 0
        for q in pools { Pool(q) } }

    // ── tiled or free windows ──
    group {
        show: sh > 0.01
        prop mglow = 0 ~140ms
        box { at: xm - 5.5, cy - 5; size: 9, 9; corner: 2; color: ink; opacity: 60% + 40% * mglow; show: not free }
        box { at: xm + 5.5, cy - 5; size: 9, 9; corner: 2; color: ink; opacity: 60% + 40% * mglow; show: not free }
        box { at: xm - 5.5, cy + 5; size: 9, 9; corner: 2; color: ink; opacity: 60% + 40% * mglow; show: not free }
        box { at: xm + 5.5, cy + 5; size: 9, 9; corner: 2; color: ink; opacity: 60% + 40% * mglow; show: not free }
        box { at: xm - 3, cy - 3; size: 16, 12; corner: 3; stroke: 1.6; color: mint; show: free }
        box { at: xm + 3, cy + 4; size: 16, 12; corner: 3; color: mint; opacity: 85%; show: free }
        group {
            opacity: mglow * if(peek < 0 and menu < 0, 1, 0)
            body {
                color: #15181b
                rim: 12%
                shadow: 0, 4, 12, 40%
                box { at: xm - 90, cy - 58; size: 240, 28; corner: 10 }
            }
            text pick(free, "Döşeli pencerelere geç (Super+W)", "Serbest pencerelere geç (Super+W)") {
                at: xm - 90, cy - 58; anchor: center; size: 12; weight: 500; width: 230; lines: 1; align: center; color: ink }
        }
        zone box mode_z { at: xm, cy; size: 40, 50; corner: 12; cursor: pointer; label: "Döşeli ya da serbest pencereler"; role: button; active: on }
        on enter mode_z { mglow: 1 }
        on leave mode_z { mglow: 0 }
        on press mode_z { emit mode }
    }

    // ── a window put away: the drop falls into the dock ──
    //  As in pleamar-wm, falling faster and faster (dt²), drawn out along its
    //  way; where it lands, the water rings, twice.
    prop dt = 1 ~340ms
    prop rp = 1 ~620ms
    on change drop.n {
        dt: 0 ~0ms
        dt: 1 ~340ms after 16ms
        rp: 0 ~0ms
        rp: 1 ~620ms after 320ms
    }
    let lx = xa + max(a - 1, 0) * 76 + 38
    let fall = dt * dt
    let dx = drop.x + (lx - drop.x) * dt
    let dy = 356 + (cy - 356) * fall
    group {
        show: dt < 0.99
        body {
            color: #9ed6bd
            rim: 30%
            shadow: 0, 3, 8, 35%
            ellipse { at: dx, dy; radius: 9 - 3 * fall; scale: 1 - 0.25 * fall, 1 + 0.6 * fall }
        }
        //  Its glint, and two droplets behind it.
        ellipse { at: dx - 2.5, dy - 3; radius: 2; scale: 1.3, 0.75; color: #ffffff; opacity: 70% }
        ellipse { at: drop.x + (lx - drop.x) * max(dt - 0.12, 0), 356 + (cy - 356) * pow(max(dt - 0.12, 0), 2); radius: 3.5; color: mint; opacity: 55% * (1 - dt) }
        ellipse { at: drop.x + (lx - drop.x) * max(dt - 0.24, 0), 356 + (cy - 356) * pow(max(dt - 0.24, 0), 2); radius: 2.2; color: mint; opacity: 40% * (1 - dt) }
    }
    group {
        show: rp < 0.99
        ellipse { at: lx, cy + 18; radius: 14 + 34 * rp; scale: 1, 0.32; stroke: 1.6 * (1 - rp) + 0.3; color: mint; opacity: 70% * (1 - rp) }
        ellipse { at: lx, cy + 18; radius: 8 + 22 * max(rp - 0.15, 0); scale: 1, 0.32; stroke: 1.2 * (1 - rp) + 0.3; color: ink; opacity: 45% * (1 - rp) }
    }

    // ── held: its windows, to pick one ──
    let p_h = max(1, peeks.count) * 30 + 20
    let px = clamp(x0 + 14 + peek * 60 + 30, 140, 1260)
    group {
        show: peek >= 0
        body {
            color: #15181b
            rim: 12%
            shadow: 0, 10, 28, 45%
            box { from: px - 130, cy - 44 - p_h; size: 260, p_h; corner: 16 }
        }
        repeat r in 0..8 {
            let ry = cy - 44 - p_h + 10 + r * 30
            group {
                show: r < peeks.count
                prop rglow = 0 ~120ms
                box { from: px - 122, ry; size: 244, 28; corner: 9; color: ink; opacity: rglow * 8% }
                text peeks.$r.title { at: px - 112, ry + 14; anchor: left center; size: 12; width: 200; lines: 1; color: ink }
                text "gizli" { at: px + 112, ry + 14; anchor: right center; size: 10; color: mint; show: peeks.$r.hidden }
                zone box row.$r { from: px - 122, ry; size: 244, 28; corner: 9; cursor: pointer; active: peek >= 0 and r < peeks.count }
                on enter row.$r { rglow: 1 }
                on leave row.$r { rglow: 0 }
                on press row.$r { peek = -1; emit go(r) }
            }
        }
    }

    // ── the right button's menu ──
    let mx = clamp(x0 + 14 + menu * 60 + 30, 120, 1280)
    let m_h = if(menu.wins > 0, 3, 2) * 32 + 16
    group {
        show: menu >= 0
        body {
            color: #15181b
            rim: 12%
            shadow: 0, 10, 28, 45%
            box { from: mx - 100, cy - 44 - m_h; size: 200, m_h; corner: 16 }
        }
        repeat k in 0..3 {
            let ky = cy - 44 - m_h + 8 + k * 32
            group {
                show: k < 2 or menu.wins > 0
                prop kglow = 0 ~120ms
                box { from: mx - 92, ky; size: 184, 30; corner: 9; color: if(k == 2, coral, ink); opacity: kglow * if(k == 2, 12%, 8%) }
                text pick(k, menu.pin, "Yeni pencere", "Pencerelerini kapat") { at: mx - 80, ky + 15; anchor: left center; size: 12; weight: 500
                          color: if(k == 2, coral, ink) }
                zone box item.$k { from: mx - 92, ky; size: 184, 30; corner: 9; cursor: pointer; active: menu >= 0 and (k < 2 or menu.wins > 0) }
                on enter item.$k { kglow: 1 }
                on leave item.$k { kglow: 0 }
                on press item.$k { menu = -1; emit menu_do(k) }
            }
        }
    }

    // ── Launchpad: impasto'nun launcher'ı gibi — arama kutusu, alfabetik
    //  uygulama listesi ve sağda "rehber" gibi büyüyen A-Z şeridi. ──
    let lpx = 700
    let lpw = 660
    let lpt = 16                           // panelin üst kenarı
    let lpb = cy - 54                      // panelin alt kenarı (şeridin üstünde)
    let lvh = lpb - lpt - 82               // listenin görünen yüksekliği
    let azh = clamp(lvh / max(azs.count, 1), 9, 20)

    //  bir uygulama satırı: simge + ad, solda harf bölümü başlığı
    component PadRow(d: record) {
        size: 576, 44
        prop rglow = 0 ~120ms
        let picked = if(sel == d.index, 1, 0)
        box { at: 288, 22; size: 572, 40; corner: 12; color: ink; opacity: 14% * picked + 8% * rglow * (1 - picked) }
        text d.letter { at: 20, 22; anchor: center; size: 12; weight: 700; color: mint; opacity: if(d.head, 70%, 0%) }
        image d.icon { at: 44, 8; size: 28, 28 }
        text d.name { at: 84, 22; anchor: left center; size: 13.5; width: 432; lines: 1; color: ink }
        //  view: yalnız çizimi kırpar; görünüm dışına kaymış satır basış yakalamasın
        zone box hit { at: 288, 22; size: 576, 44; cursor: pointer; label: d.name; role: item; selected: sel == d.index; active: appsopen and pointer.y >= lpt + 70 and pointer.y < lpt + 70 + lvh }
        on enter hit { rglow: 1 }
        on leave hit { rglow: 0 }
        on press hit { appsopen = false; emit launch_app(d.index) }
    }
    //  A-Z şeridi: harfe dokununca o bölüme atlar; tepedeki harf dock simgesi gibi büyür
    component AzLetter(L: record) {
        size: 22, azh
        prop lg = 0 ~120ms
        prop ac = 0 ~150ms
        follow ac = if(L.active, 1, 0)
        group {
            pivot: 22, azh / 2
            scale: 1 + 0.9 * ac
            text L.ch { at: 11, azh / 2; anchor: center; size: 10.5; weight: 600; color: mix(ink, mint, max(ac, lg)) }
        }
        zone box hit { at: 11, azh / 2; size: 22, azh; cursor: pointer; label: L.ch; active: appsopen }
        on enter hit { lg: 1 }
        on leave hit { lg: 0 }
        on press hit { list.scroll: L.row * 44 ~calm }
    }

    group {
        show: appsopen
        body {
            color: glass_tint
            glass: 90%
            lens: false
            rim: 42%
            highlight: 55%
            shadow: 0, 18, 48, 48%
            box { at: lpx, (lpt + lpb) / 2; size: lpw, lpb - lpt; corner: 26 }
        }
        //  arama alanı
        image apps_ico { at: lpx - lpw / 2 + 22, lpt + 30 - 9; size: 18, 18 }
        input draft { at: lpx - lpw / 2 + 52, lpt + 22; width: lpw - 150; size: 15; color: ink; placeholder: "Ara…" }
        box { at: lpx, lpt + 58; size: lpw - 36, 1; color: ink; opacity: 20% }
        text "Sonuç yok" { at: lpx, lpt + 130; anchor: center; size: 13; color: ink; opacity: 45%; show: g == 0 }
        //  alfabetik uygulama listesi
        column list { at: lpx - lpw / 2 + 16, lpt + 70; view: lpw - 84, lvh; step: 44; gap: 0
            for d in pad { PadRow(d) }
        }
        //  kaydırma çubuğu
        box { from: lpx + lpw / 2 - 50, lpt + 70 + list.scroll / max(list.content, 1) * lvh
              size: 3, lvh * lvh / max(list.content, lvh); corner: 2; color: ink; opacity: 22%; show: list.content > lvh }
        //  A-Z hızlı şeridi
        column az { at: lpx + lpw / 2 - 34, lpt + 70; gap: 0
            for L in azs { AzLetter(L) }
        }
    }

    //  listenin tepesindeki harfi mantığa bildir (şeritte büyüsün)
    on change floor(list.scroll / 44) { emit slid(floor(list.scroll / 44)) }
    //  açılınca arama alanına odak; klavye gezinmesi; Esc kapatır
    on change appsopen while appsopen { focus draft; sel = 0; list.scroll: 0 ~0ms }
    on key Escape { appsopen = false }
    on key Down { sel = min(sel + 1, max(g - 1, 0)) }
    on key Up { sel = max(sel - 1, 0) }
    on change sel { list.scroll: clamp(sel * 44 - 140, 0, max(list.content - lvh, 0)) ~calm }
    on submit draft { appsopen = false; emit launch_app(sel) }
}
